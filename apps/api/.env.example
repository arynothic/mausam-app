# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Weather provider: openmeteo | mock | imd
# openmeteo — live forecast (default, no API key)
# mock — deterministic offline/demo data
# imd — stub adapter (maps to mock until IMD endpoints are wired)
WEATHER_PROVIDER=openmeteo

# Optional Redis (falls back to in-memory cache when unset)
# REDIS_URL=redis://localhost:6379

# Profile DB (Phase 5+ — not used yet)
# DATABASE_URL=file:./dev.db

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
